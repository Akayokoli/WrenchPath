# Local server settings: keep these defaults.
PORT=4000
HOST=127.0.0.1

# Use anthropic for Claude, openai for OpenAI, or mock for a static offline reply.
AI_PROVIDER=mock
# In Claude mode, uncomment this line (or omit AI_MODEL to use the Claude default).
# AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OpenAI mode uses gpt-5.6-terra by default and requires its own key.
OPENAI_API_KEY=

AI_TIMEOUT_MS=20000
MEMORY_DIR=data/conversations
