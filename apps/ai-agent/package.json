{
  "name": "@wrenchpath/ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "node --import tsx scripts/check-live.ts",
    "test:profiles:live": "node --import tsx scripts/check-profiles-live.ts",
    "test:roadmaps:live": "node --import tsx scripts/check-roadmaps-live.ts",
    "test:progress:live": "node --import tsx scripts/check-progress-live.ts",
    "test:journeys:live": "node --import tsx scripts/check-journeys-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "fastify": "^5.12.5",
    "openai": "^7.32.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  }
}
